{
  "algo-lab-strict-guard": {
    "PreToolUse": [
      {
        "matcher": "write_file|edit_file|run_command",
        "hooks": [
          {
            "type": "command",
            "command": "python ./hooks/enforce.py",
            "timeout": 15
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "write_file|edit_file",
        "hooks": [
          {
            "type": "command",
            "command": "python ./hooks/enforce.py",
            "timeout": 15
          }
        ]
      }
    ]
  }
}
